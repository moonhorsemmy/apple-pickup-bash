# apple-pickup-bash 配置模板：cp config.example.env config.env 后按需修改
LOCALE="zh_CN"
BASE_URL="https://www.apple.com.cn"

# 门店编号（查询：scripts/catalog.sh stores 城市名）
STORE="R359"

# 零件号，可盯多个（查询：scripts/catalog.sh parts "18 Pro 512"）
PARTS=("MJT74CH/A")

# 可选：填家族名则忽略 PARTS、自动展开全系（iphone-18-pro / iphone-air / macbook-air...）
FAMILY=""

# 暖场 Referer 页（按品类换 buy-iphone / buy-ipad / buy-mac）
BUY_PAGE="https://www.apple.com.cn/shop/buy-iphone"

# Bark 推送地址（Bark App 首页复制），留空=只打印不推送
BARK_URL=""

# 代理（仅 catalog.sh refresh 拉快照用；国内网络如 http://127.0.0.1:7897，留空=直连）
PROXY=""

# 全国扫描间隔秒（下限 4）
SWEEP_PACE=4
